{
  "name": "tengen-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "weights": "sh scripts/fetch-rapfi-weights.sh",
    "build:all": "npm run wasm && npm run weights && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src index.html",
    "lint": "prettier --check src index.html && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
